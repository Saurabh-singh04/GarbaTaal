# Copy to .env and fill in. .env is gitignored — never commit the real values.
# The same keys go into GitHub repo secrets (for workflows), Render env vars
# (for the API) and Vercel env vars (for the frontend build).

# ── Supabase ──────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                 # safe in the browser; RLS is what protects data
SUPABASE_SERVICE_KEY=              # SERVER ONLY. Bypasses RLS entirely. Never ship to the client.
# Leave empty. Tokens are signed with asymmetric keys (ECC P-256), so the API
# validates them with PUBLIC keys from /auth/v1/.well-known/jwks.json — there is
# no signing secret to copy. Only set this if you still have tokens issued under
# the legacy HS256 shared secret.
SUPABASE_JWT_SECRET=
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Use the POOLER (port 6543), not 5432. .NET's connection pool against the
# direct port will exhaust Supabase's connection limit on the first busy night.
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:6543/postgres?pgbouncer=true

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                  # public by design
GOOGLE_CLIENT_SECRET=              # goes into Supabase Auth settings, not the app

# ── Razorpay ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx  # key_id is public (it reaches the checkout)
RAZORPAY_KEY_SECRET=               # SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=           # different from KEY_SECRET — used for webhook signatures

# ── Cloudflare R2 (profile photos: 10 GB free, zero egress cost) ──────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=garbataal-photos
R2_PUBLIC_URL=

# ── Firebase Cloud Messaging ──────────────────────────────────────────────
FCM_SERVER_KEY=

# ── Internal ──────────────────────────────────────────────────────────────
JOB_TOKEN=                         # shared secret so only GitHub Actions can trigger /jobs/*
API_BASE_URL=https://garbataal-api.onrender.com
